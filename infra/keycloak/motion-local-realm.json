{
  "realm": "motion-local",
  "enabled": true,
  "registrationAllowed": true,
  "verifyEmail": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@motion.local",
    "fromDisplayName": "Motion Local",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "roles": {
    "realm": [
      {
        "name": "default-roles-motion-local",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": { "realm": ["offline_access", "uma_authorization", "PARTICIPANT"] }
      },
      { "name": "offline_access", "description": "${role_offline-access}", "composite": false, "clientRole": false },
      { "name": "uma_authorization", "description": "${role_uma_authorization}", "composite": false, "clientRole": false },
      { "name": "PARTICIPANT" },
      { "name": "SPECIALIST" },
      { "name": "CONTENT_ADMIN" },
      { "name": "SYSTEM_ADMIN" }
    ]
  },
  "defaultRoles": ["default-roles-motion-local", "offline_access", "uma_authorization"],
  "clients": [
    {
      "clientId": "motion-web",
      "name": "Motion Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": ["basic", "web-origins", "acr", "roles", "profile", "email", "motion-email-verified"],
      "protocolMappers": [
        {
          "name": "motion-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "motion-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "basic",
      "description": "OpenID Connect scope for basic claims",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "${scopeBasic}"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "motion-email-verified",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": { "user.attribute": "email", "claim.name": "email", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" }
        },
        {
          "name": "email-verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": { "user.attribute": "emailVerified", "claim.name": "email_verified", "jsonType.label": "boolean", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true" }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "8f6e9cc1-1c1e-4f7a-98f4-3c0c3f40ac01",
      "username": "demo.participant",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Uczestnik",
      "email": "demo.participant@local.test",
      "credentials": [
        {
          "type": "password",
          "value": "demo-participant-local-only",
          "temporary": false
        }
      ],
      "realmRoles": ["PARTICIPANT"]
    },
    {
      "id": "8f6e9cc1-1c1e-4f7a-98f4-3c0c3f40ac02",
      "username": "demo.editor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Redaktor",
      "email": "demo.editor@local.test",
      "credentials": [
        {
          "type": "password",
          "value": "demo-editor-local-only",
          "temporary": false
        }
      ],
      "realmRoles": [
        "CONTENT_ADMIN",
        "SYSTEM_ADMIN",
        "SPECIALIST"
      ]
    }
  ]
}
