# Copy to deploy/.env on the VPS, set chmod 600, and never commit it.
APP_DOMAIN=app.example.invalid
AUTH_DOMAIN=auth.example.invalid
ACME_EMAIL=ops@example.invalid
RELEASE_SHA=replace-with-full-git-sha
BACKEND_IMAGE_REPOSITORY=ghcr.io/owner/moves-api
WEB_IMAGE_REPOSITORY=ghcr.io/owner/moves-web

MOVES_DB_NAME=moves
MOVES_DB_USER=moves_app
MOVES_DB_PASSWORD=replace-with-long-random-secret
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak_app
KEYCLOAK_DB_PASSWORD=replace-with-long-random-secret
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=replace-with-admin-name
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-long-random-secret

KEYCLOAK_REALM=moves
KEYCLOAK_CLIENT_ID=motion-web
OIDC_AUDIENCE=motion-api

PARTICIPANT_INVITATION_DELIVERY_ENABLED=false
PARTICIPANT_INVITATION_DELIVERY_SENDER=no-reply@example.invalid
PARTICIPANT_INVITATION_DELIVERY_SMTP_HOST=smtp.example.invalid
PARTICIPANT_INVITATION_DELIVERY_SMTP_PORT=587
PARTICIPANT_INVITATION_DELIVERY_CONNECT_TIMEOUT=5s
PARTICIPANT_INVITATION_DELIVERY_READ_TIMEOUT=5s
PARTICIPANT_INVITATION_DELIVERY_WRITE_TIMEOUT=5s
EXERCISE_IMPORT_MAX_FILE_BYTES=10485760
EXERCISE_IMPORT_MAX_RECORD_BYTES=262144
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=10MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=12MB

# restic S3 repository. Keep RESTIC_PASSWORD_FILE outside this checkout where possible.
RESTIC_REPOSITORY=s3:s3.amazonaws.com/example-bucket/moves
RESTIC_PASSWORD_FILE=/etc/moves/restic-password
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
