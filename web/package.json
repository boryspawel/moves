{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "api:snapshot": "cd .. && mvn -q -Dtest=OpenApiSnapshotIntegrationTest -Dopenapi.snapshot=web/openapi/openapi.json test",
    "api:generate": "openapi-generator-cli generate -i openapi/openapi.json -g typescript-fetch -o src/app/api/generated --additional-properties=npmName=@moves/api-client,npmVersion=1.0.0 && node scripts/patch-openapi-client.mjs",
    "api:format": "prettier --write src/app/api/generated",
    "api:refresh": "npm run api:snapshot && npm run api:generate && npm run api:format",
    "api:verify": "npm run api:refresh && git diff --exit-code -- openapi/openapi.json src/app/api/generated"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.6",
    "@angular/animations": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "keycloak-js": "26.2.5",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.6",
    "@axe-core/playwright": "4.14.0",
    "@openapitools/openapi-generator-cli": "2.42.2",
    "@playwright/test": "1.65.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.10.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  }
}
